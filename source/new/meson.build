quickerDSDAIncludeDirs = [
  '.',
  '..',
		'core/prboom2/src'
]

quickerDSDACompileArgs = [
	'-Wfatal-errors',
	'-DHAVE_CONFIG_H',
	'-Dstricmp=strcasecmp',
	'-Dstrnicmp=strncasecmp',
	'-DNDEBUG',
	'-ffast-math',
	'-Wno-unused-function',
	'-Wno-switch',
	'-Wno-pointer-sign',
	'-Wno-sign-compare',
	'-Wno-stringop-overflow',
	'-Wno-format-truncation',
	'-Wno-unused-but-set-variable',
	'-Wno-unused-variable'
]

# DSDA dependency

 quickerDSDADependency = declare_dependency(
  compile_args        : [  quickerDSDACompileArgs, '-D__STORAGE_MODIFIER=__thread', '-ftls-model=initial-exec', '-pthread', ],
	link_args        : [   '-lpthread' ],
  include_directories : include_directories(quickerDSDAIncludeDirs),
  sources             : [ quickerDSDASrc ],
  dependencies        : [ ]
 )

# QuickerDSDA Core Configuration

 newDependency = declare_dependency(
  compile_args        : [ '-D_DEGLOB_TLS_INIT' ],
  include_directories : [ include_directories( ['.', '..'] )],
  sources             : [ ],
  dependencies        : [ 
			                       quickerDSDADependency,
                        ]
 )
