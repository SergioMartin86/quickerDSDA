# Test rules

build test: phony meson-internal__test

build meson-internal__test: CUSTOM_COMMAND all PHONY
 COMMAND = /home/jaffar/.local/bin/meson test --no-rebuild --print-errorlogs
 DESC = Running$ all$ tests.
 pool = console

build benchmark: phony meson-internal__benchmark

build meson-internal__benchmark: CUSTOM_COMMAND all PHONY
 COMMAND = /home/jaffar/.local/bin/meson test --benchmark --logbase benchmarklog --num-processes=1 --no-rebuild
 DESC = Running$ benchmark$ suite.
 pool = console

# Install rules

build install: phony meson-internal__install

build meson-internal__install: CUSTOM_COMMAND PHONY | all
 DESC = Installing$ files.
 COMMAND = /home/jaffar/.local/bin/meson install --no-rebuild
 pool = console

build dist: phony meson-internal__dist

build meson-internal__dist: CUSTOM_COMMAND PHONY
 DESC = Creating$ source$ packages
 COMMAND = /home/jaffar/.local/bin/meson dist
 pool = console

# Suffix

build scan-build: phony meson-internal__scan-build

build meson-internal__scan-build: CUSTOM_COMMAND PHONY
 COMMAND = /home/jaffar/.local/bin/meson --internal scanbuild /home/jaffar/jaffarPlus/extern/quickerDSDA /home/jaffar/jaffarPlus/extern/quickerDSDA/build extern /home/jaffar/.local/bin/meson -DbuildPlayer=true -DjaffarCommon:testLoggers=false -DonlyFree=false
 pool = console

build clang-format: phony meson-internal__clang-format

build meson-internal__clang-format: CUSTOM_COMMAND PHONY
 COMMAND = /home/jaffar/.local/bin/meson --internal clangformat /home/jaffar/jaffarPlus/extern/quickerDSDA /home/jaffar/jaffarPlus/extern/quickerDSDA/build
 pool = console

build clang-format-check: phony meson-internal__clang-format-check

build meson-internal__clang-format-check: CUSTOM_COMMAND PHONY
 COMMAND = /home/jaffar/.local/bin/meson --internal clangformat /home/jaffar/jaffarPlus/extern/quickerDSDA /home/jaffar/jaffarPlus/extern/quickerDSDA/build --check
 pool = console

build uninstall: phony meson-internal__uninstall

build meson-internal__uninstall: CUSTOM_COMMAND PHONY
 COMMAND = /home/jaffar/.local/bin/meson --internal uninstall
 pool = console

build all: phony meson-test-prereq meson-benchmark-prereq basePlayer pTester tTester newTester baseTester lmpConverter

build meson-test-prereq: phony pTester

build meson-benchmark-prereq: phony 

build clean: phony meson-internal__clean

build meson-internal__clean: CUSTOM_COMMAND PHONY
 COMMAND = /home/jaffar/.local/bin/ninja -t clean
 description = Cleaning

build build.ninja: REGENERATE_BUILD ../meson.build ../meson_options.txt ../source/meson.build ../source/base/meson.build ../source/new/meson.build ../extern/jaffarCommon/meson.build ../extern/jaffarCommon/meson_options.txt ../tests/meson.build meson-private/coredata.dat
 pool = console

build reconfigure: REGENERATE_BUILD PHONY
 pool = console

build ../meson.build ../meson_options.txt ../source/meson.build ../source/base/meson.build ../source/new/meson.build ../extern/jaffarCommon/meson.build ../extern/jaffarCommon/meson_options.txt ../tests/meson.build meson-private/coredata.dat: phony 

default all

